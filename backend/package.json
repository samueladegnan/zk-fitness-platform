{
  "name": "zk-fitness-backend",
  "version": "1.0.0",
  "description": "Node.js API for sessions and opaque encrypted workout sync payloads.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node migrate.js && node server.js",
    "dev": "node --watch server.js",
    "test": "node migrate.js && node --test --test-force-exit test/*.test.js",
    "lint": "eslint .",
    "migrate": "node migrate.js"
  },
  "overrides": {
    "underscore": "1.13.8",
    "js-yaml": "5.2.3"
  },
  "keywords": [
    "privacy",
    "fitness",
    "encryption",
    "express",
    "sync"
  ],
  "author": "Samuel Degnan",
  "license": "MIT",
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^15.0.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
