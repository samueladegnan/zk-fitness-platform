NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:3001

# Local Docker Compose database (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_USER=fitness
DB_PASSWORD=fitness
DB_NAME=fitness_db

# Production managed Postgres (e.g. Neon). When set, it overrides DB_* above.
# DATABASE_URL=postgresql://user:password@host:5432/database


# Optional: control backend log verbosity (debug, info, warn, error).
# LOG_LEVEL=debug
